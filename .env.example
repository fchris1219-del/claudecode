# ntfy.sh 推送配置
# iPhone 安装 ntfy app 后订阅此 topic（设成不易猜到的随机字符串）
NTFY_BASE_URL=https://ntfy.sh
NTFY_DEFAULT_TOPIC=myphone-changeme123

# 如果使用 ntfy.sh 保留 topic（需登录），填入 access token；否则留空
NTFY_AUTH_TOKEN=

# API 鉴权密钥（iOS 快捷指令和 curl 调用时需要携带）
API_KEY=change-me-long-random-string

# 服务器监听地址和端口
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# SQLite 数据库路径
DB_PATH=./todos.db

# 时区（用于定时任务）
TIMEZONE=Asia/Shanghai

# Anthropic API 密钥（用于论文总结和讨论）
# 从 https://console.anthropic.com 获取
ANTHROPIC_API_KEY=

# 定时任务默认时间（Cron 格式）
EVENING_PROMPT_CRON=0 21 * * *
MORNING_SEARCH_CRON=0 8 * * *
